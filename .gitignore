# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content pipeline: ignore ONLY what regenerates deterministically.
# Model derivations, adjudication rulings, teaching content, authored diagrams,
# alt text and the import CSV are the evidence behind every answer, cost real
# tokens to produce and would not come back identical. Those are committed.
content-pipeline/out/*.items.jsonl
content-pipeline/out/*.report.json
content-pipeline/out/*-input.*.json
content-pipeline/out/diagrams/*.clean.png
content-pipeline/out/diagrams/*.compare.png
content-pipeline/out/diagrams/*.preview*.png
content-pipeline/out/diagrams/*three-way*.png
content-pipeline/out/diagrams/*contact*.png
content-pipeline/out/diagrams/rod-zoom.png
content-pipeline/out/diagrams/redraw-report.json
# raw exam source papers and diagrams: 75MB, kept out of history
Exam Questions/
