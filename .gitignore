# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content pipeline: ignore ONLY what regenerates deterministically.
# Model derivations, adjudication rulings, teaching content, authored diagrams,
# alt text and the import CSV are the evidence behind every answer, cost real
# tokens to produce and would not come back identical. Those are committed.
content-pipeline/out/*.items.jsonl
content-pipeline/out/*.report.json
content-pipeline/out/*-input.*.json
content-pipeline/out/*-input-*.json
content-pipeline/out/*-changed.*.json
# diagrams live in one folder per subject; only the SVGs and alt text are kept
content-pipeline/out/diagrams/**/*.png
content-pipeline/out/diagrams/**/redraw-report.json
# worker scratch: the exact inputs each model saw and its raw session log
content-pipeline/work/
# raw exam source papers and diagrams: 75MB, kept out of history
Exam Questions/
content-pipeline/out/*PREVIEW*
content-pipeline/out/*.preview.html
__pycache__/
content-pipeline/syllabi/
content-pipeline/out/review-queue.json
content-pipeline/out/review-batch.html
content-pipeline/out/gates.html
